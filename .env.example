# Base URL of the mock API. Change only if you move the mock server.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Mock server tuning — raise the latency or the flake rate to test your
# loading and error states under worse conditions than the default.
MOCK_PORT=4000
MOCK_LATENCY_MS=220
MOCK_FLAKE_RATE=0.12
